# ===================================================================
# Gnani Sahaayak - Local Environment Configuration Template
# ===================================================================
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' with real secrets to version control.
# ===================================================================

# Gnani AI API Key
# Generated from the Gnani Developer Dashboard: https://console.gnani.ai
GNANI_API_KEY=your_gnani_api_key_here

# Gnani Vachana Speech API Gateway Base URL
GNANI_API_BASE_URL=https://api.vachana.ai

# Authentication Header Name (Verified standard: X-API-Key-ID)
GNANI_AUTH_HEADER=X-API-Key-ID

# Prisma v2.5 Speech-to-Text Default Language
# Supported: hi-IN, en-IN, kn-IN, ta-IN, te-IN, mr-IN, gu-IN, bn-IN, pa-IN, ml-IN
GNANI_PRISMA_LANGUAGE=hi-IN

# Timbre v2.5 Text-to-Speech Defaults
GNANI_TIMBRE_MODEL=timbre-v2.5
GNANI_TIMBRE_VOICE=Nalini
GNANI_TIMBRE_LANGUAGE=hi-IN
GNANI_TIMBRE_SPEED=1.0

# Timbre Audio Sample Rate (16000 Hz recommended for speech pipeline)
GNANI_TIMBRE_SAMPLE_RATE=16000

# Network Connection & Read Timeouts (in seconds)
GNANI_CONNECT_TIMEOUT=10.0
GNANI_PRISMA_READ_TIMEOUT=60.0
GNANI_TIMBRE_READ_TIMEOUT=60.0
